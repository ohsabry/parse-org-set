{
  "name": "@parse-org-set/cli",
  "version": "0.1.2",
  "description": "Extract the sounds in ORG 24 .Set and .Instrument files as WAV files",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohsabry/parse-org-set.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "org24",
    "music-studio",
    "sofeh",
    "set",
    "sampler",
    "wav",
    "digitakt",
    "arabic"
  ],
  "bin": {
    "parse-org-set": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/main.ts --target bun --outfile dist/main.js && cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@parse-org-set/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
