{
  "name": "parse-org-set-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "tsc": "tsc -p packages/core && tsc -p packages/core/test && tsc -p packages/cli && tsc -p packages/cli/test && tsc -p packages/web && tsc -p packages/web/test && tsc -p packages/web/scripts",
    "test": "bun test",
    "verify": "bun run tsc && bun run lint && bun run fmt:check && bun test",
    "inspect": "bun packages/cli/src/main.ts inspect",
    "extract": "bun packages/cli/src/main.ts extract",
    "web": "bun packages/web/index.html",
    "web:build": "bun packages/web/scripts/build.ts"
  }
}
